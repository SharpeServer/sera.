# =============================================
# SERA — Personal AI Operator — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- WhatsApp / Meta ---
# From Meta Developer Portal → Your App → WhatsApp → API Setup
VERIFY_TOKEN=your_custom_webhook_verify_token_here
META_ACCESS_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# The public WhatsApp number users message to reach SERA (with country code, no +)
# Used by the website CTA link
SERA_WHATSAPP_NUMBER=1234567890

# --- Authorized Users ---
# Comma-separated WhatsApp numbers (with country code, no +, no spaces) allowed to control SERA
ALLOWED_WHATSAPP_NUMBERS=1234567890,0987654321

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# --- Web Search ---
# Get a free key at https://serpapi.com or https://serper.dev
# Supported providers: serpapi | serper
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=your_web_search_api_key

# --- Gmail ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
# Filled automatically after OAuth flow — do not set manually
GMAIL_REFRESH_TOKEN=

# --- GitHub ---
# From GitHub → Settings → Developer Settings → Personal Access Tokens
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username

# --- Vercel ---
# From Vercel → Settings → Tokens
VERCEL_TOKEN=your_vercel_api_token
VERCEL_TEAM_ID=
# Leave empty if using personal account

# --- Files / Workspace ---
# Absolute or relative path to the workspace directory SERA can read/write
WORKSPACE_PATH=./workspace

# --- Reminders ---
# IANA timezone string, e.g. America/New_York, Asia/Kolkata, Europe/London
REMINDER_TIMEZONE=UTC
